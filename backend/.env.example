# Lume backend environment. Copy to backend/.env for local dev (loaded at
# startup; real environment variables always win). Production: set real env
# vars on the host — never commit a filled-in .env.

# ── required ──────────────────────────────────────────────────────────────────
# Supabase Postgres connection string (Project Settings → Database)
DATABASE_URL=

# Clerk (JWT verification via JWKS + user webhook signature)
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Expected `iss` claim, e.g. https://your-instance.clerk.accounts.dev — this is
# what stops a Clerk JWT-template token minted for a DIFFERENT service from
# authenticating here as a session. Warned about (not fatal) in production only,
# so an unset value fails open: set it.
CLERK_ISSUER=

# ── deployment ────────────────────────────────────────────────────────────────
# Public origin of THIS API (CORS, OAuth redirect + webhook URLs derive from it).
# Dev default: http://localhost:8080
LUME_BASE_URL=
# Listen port (Railway/Fly/Heroku set this automatically); falls back to the
# LUME_BASE_URL port, then 8080.
PORT=
# Fallback calendar timezone (IANA name) for streaks/morning-brief math when a
# request has no X-Timezone header (the app sends the device zone), and for the
# background sweep.
LUME_TIMEZONE=Australia/Sydney

# ── feature keys (absent ⇒ the affected endpoints return 503, rest keeps working)
# RevenueCat webhook Authorization header value (set the same value in the RC dashboard)
REVENUECAT_WEBHOOK_AUTH=
# Gemini: photo and label scans, and by default AI insights / morning brief /
# natural-language query. The only AI key the server needs.
GEMINI_API_KEY=
# Text AI provider for insights / brief / query: gemini (default) or claude.
LLM_PROVIDER=gemini
# Gemini model for insights / brief / query (see AI_COSTS.md for the choice).
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional Claude fallback, used only when LLM_PROVIDER=claude.
ANTHROPIC_API_KEY=
# Same user + same AI input within this many seconds is served from memory.
LUME_AI_CACHE_SECONDS=900
# Paid AI calls (photo, pipeline and label scans, insights, brief, query) per
# user per UTC day. Empty uses the default of 20; 0 turns the cap off; any
# value that is not a whole number of 0 or more stops the server at startup.
LUME_AI_DAILY_LIMIT=
# Optional USDA FoodData Central, the last food search fallback. Empty skips
# USDA; the Australian food table and Open Food Facts still answer.
USDA_API_KEY=

# ── integrations (Strava / WHOOP imports) ─────────────────────────────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# base64 of exactly 32 random bytes — AES-256-GCM for stored OAuth tokens
# (generate: openssl rand -base64 32). Absent ⇒ integration token routes 503.
INTEGRATION_ENCRYPTION_KEY=
