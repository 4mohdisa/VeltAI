# Lumo backend environment. Copy to backend/.env for local dev (loaded at
# startup; real environment variables always win). Production: set real env
# vars on the host — never commit a filled-in .env.

# ── required ──────────────────────────────────────────────────────────────────
# Supabase Postgres connection string (Project Settings → Database)
DATABASE_URL=

# Clerk (JWT verification via JWKS + user webhook signature)
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ── deployment ────────────────────────────────────────────────────────────────
# Public origin of THIS API (CORS, OAuth redirect + webhook URLs derive from it).
# Dev default: http://localhost:8080
LUMO_BASE_URL=
# Listen port (Railway/Fly/Heroku set this automatically); falls back to the
# LUMO_BASE_URL port, then 8080.
PORT=
# Server-side calendar timezone for streaks/morning-brief math (IANA name).
LUMO_TIMEZONE=UTC

# ── feature keys (absent ⇒ the affected endpoints return 503, rest keeps working)
# RevenueCat webhook Authorization header value (set the same value in the RC dashboard)
REVENUECAT_WEBHOOK_AUTH=
# Gemini vision for /api/scan
GEMINI_API_KEY=
# Claude for AI insights / morning brief / natural-language query
ANTHROPIC_API_KEY=
# USDA FoodData Central (DEMO_KEY works with low rate limits)
USDA_API_KEY=DEMO_KEY

# ── integrations (Strava / WHOOP imports) ─────────────────────────────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# base64 of exactly 32 random bytes — AES-256-GCM for stored OAuth tokens
# (generate: openssl rand -base64 32). Absent ⇒ integration token routes 503.
INTEGRATION_ENCRYPTION_KEY=
