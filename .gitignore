# ── secrets — NEVER commit real keys (.env.example files ARE tracked) ─────────
.env
.env.local
.env*.local

# ── dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Expo / Metro ──────────────────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# ── generated native projects (expo prebuild output) ──────────────────────────
/ios
/android
.kotlin/
*.orig.*

# ── signing material ──────────────────────────────────────────────────────────
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# ── build output ──────────────────────────────────────────────────────────────
*.tsbuildinfo
backend/server
backend/bin/

# ── coverage / test output ────────────────────────────────────────────────────
coverage/
.coverage
coverage.out
*.lcov

# ── local one-off automation (dev tooling, not part of the product) ───────────
/scripts/audit-routes.mjs

# ── logs / OS / editor cruft ──────────────────────────────────────────────────
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
.idea/
*.swp
/tmp/

# ── large font source image — fonts are extracted to assets/fonts/ ────────────
SF-Pro.dmg
*.dmg

# ── built binaries ────────────────────────────────────────────────────────────
# A committed or stray server binary is how a three-day-old `lumoserver` ended
# up serving :8080 from a scratchpad on 2026-08-08 while looking healthy.
# Build from source; never run a binary you did not just build (DEPLOY.md).
/backend/server
/backend/lumoserver
/backend/lume-server
*.test
