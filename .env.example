# Lumo app environment (EXPO_PUBLIC_* vars are inlined into the JS bundle).
# Copy to .env — Expo loads it automatically. NEVER commit real keys.

# Clerk publishable key (Dashboard → API Keys → Publishable key, pk_...).
# Absent → the app runs in "local dev auth mode" (no auth, fully navigable).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# RevenueCat iOS SDK key (Dashboard → Project → API Keys → Apple, appl_...).
# Absent → "billing-disabled dev mode" (entitlement defaults to true).
# NOTE: purchases require a NATIVE build — Expo Go cannot run this SDK.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Deployed backend origin (https://api.example.com). Absent → http://localhost:8080.
# A release build MUST set this.
EXPO_PUBLIC_API_URL=
